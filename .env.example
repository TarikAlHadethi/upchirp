# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Agent model: ollama (default, offline) or anthropic
UPCHIRP_MODEL=ollama
OLLAMA_HOST=http://localhost:11434
AWS_PROFILE=upchirp
# Alerts (optional). Telegram: a bot token from @BotFather and your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Or Slack: an incoming webhook URL
SLACK_WEBHOOK_URL=
